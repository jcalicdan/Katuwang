
@model IEnumerable<Katuwang.Models.JoinModel.MaytungkulinMasterlist>
@{
    ViewData["Title"] = "PANGANGALAGA";
    ViewData["Breadcrumps"] = "PANGANGALAGA / Maytungkulin / Create";
    ViewData["Header"] = "Masterlist ng Maytungkulin";
}
<div class="card">
    <div class="card-body">
        <h5 class="card-title">Mga Maytungkulin</h5>
        <table class="table table-borderless datatable">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Prk-Grp</th>
                    <th scope="col">Kapisanan</th>
                    <th scope="col">Tungkulin</th>
                    <th scope="col">Remarks1</th>
                    <th scope="col">Remarks2</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNo = 0; }
                @foreach (var person in Model)
                {
                <tr>
                    <td>@person.Maytungkulin.entryid</td>

                    <td>
                        @if (person.Masterlist.spousename == "")
                        {
                            @if (@person.Masterlist.fathersname == "NODATA")
                            {<span>@person.Masterlist.givenname @person.Masterlist.mothersname</span>}
                        else
                        {<span>@person.Masterlist.givenname @person.Masterlist.fathersname</span>}
                        }
                        else
                        {<span>@person.Masterlist.givenname @person.Masterlist.spousename</span>}
                    </td>
                    <td>@person.Masterlist.purok-@person.Masterlist.grupo</td>
                    <td>@person.Masterlist.organization</td>
                    <td>@person.Maytungkulin.duty</td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="remarks1" @if (@person.Maytungkulin.remarks1 == "1") { @Html.Raw("checked") }>
                        </div>

                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="remarks2" @if (@person.Maytungkulin.remarks2 == "1") { @Html.Raw("checked") }>
                        </div>

                    </td>
                    <td>
                        <a asp-controller="Maytungkulin" asp-action="Update" asp-route-Id="@person.Maytungkulin.entryid"><span class="badge rounded-pill bg-primary">SELECT</span></a>
                        <a asp-controller="Maytungkulin" asp-action="Delete" asp-route-Id="@person.Maytungkulin.entryid"><span class="badge rounded-pill bg-danger">DELETE</span></a>
                    </td>

                </tr>
                }
            </tbody>
        </table>
        <!-- End Default Table Example -->
    </div>
</div>




<script type="text/javascript">
    $(document).on('change', '#remarks1', function () {
        var isChecked = $(this).prop('checked');
        var entryId = $(this).closest('tr').find('td:first').text();

        $('#loading').modal('show');

        // Add a delay of 1 second before sending the AJAX request
        setTimeout(function() {
            $.ajax({
                url: '@Url.Action("OrasNgPanata", "Maytungkulin")',
                type: 'POST',
                data: { entryId: entryId, isChecked: isChecked },
                success: function (result) {
                    $('#loading').modal('hide');
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log(textStatus + ': ' + errorThrown);
                }
            });
        }, 1000);
    });
    $(document).on('change', '#remarks2', function () {
        var isChecked = $(this).prop('checked');
        var entryId = $(this).closest('tr').find('td:first').text();

        $('#loading').modal('show');

        // Add a delay of 1 second before sending the AJAX request
        setTimeout(function() {
            $.ajax({
                url: '@Url.Action("UpdateIsUpdated", "Maytungkulin")',
                type: 'POST',
                data: { entryId: entryId, isChecked: isChecked },
                success: function (result) {
                    $('#loading').modal('hide');
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log(textStatus + ': ' + errorThrown);
                }
            });
        }, 1000);
    });

</script>