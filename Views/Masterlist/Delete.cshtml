@model Katuwang.Models.Masterlist
@{
    ViewData["Title"] = "SENSO";
    ViewData["Breadcrumps"] = "SENSO / Masterlist / Edit";
    ViewData["Header"] = "Impormasyon ng Kapatid";
}


<section class="section profile">
    <div class="row mb-3">
        <form class="row mb-3 g-3 needs-validation" novalidate method="post" asp-action="Delete">
            <div class="col-xl-4">

                <div class="card">
                    <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">

                        <img src="~/assets/img/profile-img.jpg" alt="Profile" class="rounded-circle">
                        <h2>@Model.givenname</h2>
                        <h3>Purok - @Model.purok  Grupo - @Model.grupo</h3>
                        <div class="mt-3">
                            <h1><span class="badge bg-danger">DELETE MODE <i class="bi bi-trash"></i></span></h1>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-3">
                    <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" type="button"><h3>Delete</h3></button>
                </div><!-- Basic Modal -->
                <div class="modal fade" id="deleteModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Delete Record</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete @Model.givenname's record?'</div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-success"s data-bs-dismiss="modal">No</button>
                                <button type="submit" class="btn btn-danger">Yes</button>
                            </div>
                        </div>
                    </div>
                </div><!-- End Basic Modal-->

            </div>

            <div class="col-xl-8">
                <div class="card">
                    <div class="card-body pt-3">

                        <h5 class="card-title">Personal na Impormasyon</h5>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="givenname"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="givenname">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="suffix"></label></h5>
                            <div class="col-lg-9">
                                <select disabled class="form-select" id="suffix" aria-label="Suffix" placeholder="placeholder" asp-for="suffix">
                                    <option value="" selected></option>
                                    <option value="Jr.">Jr.</option>
                                    <option value="Sr.">Sr.</option>
                                    <option value="I">I</option>
                                    <option value="II">II</option>
                                    <option value="III">III</option>
                                    <option value="IV">IV</option>
                                    <option value="V">V</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="mothersname"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="mothersname">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="fathersname"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="fathersname">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="gender"></label></h5>
                            <div class="col-lg-9">
                                <select disabled class="form-select" id="gender" aria-label="Gender" placeholder="placeholder" asp-for="gender">
                                    <option value="M">Lalake</option>
                                    <option value="F" selected>Babae</option>
                                </select>
                            </div>
                        </div>

   
                        <input hidden type="date" class="form-control" value="@Model.birthdate.ToString("yyyy-MM-dd")" asp-for="birthdate">
               
                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="civilstatus"></label></h5>
                            <div class="col-lg-9">
                                <select disabled class="form-select" id="civilstatus" aria-label="CivilStatus" placeholder="placeholder" asp-for="civilstatus">
                                    <option value="S" selected>Single</option>
                                    <option value="M">Married</option>
                                    <option value="W">Widow</option>
                                    <option value="P">Separated</option>
                                    <option value="A">Annulled</option>
                                    <option value="D">Divorced</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="spouse"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="spouse">
                            </div>
                        </div>

                        <input hidden type="date" class="form-control" value="@Model.weddingdate.ToString("yyyy-MM-dd")" asp-for="weddingdate">
                        
                        <hr />
                        <h5 class="card-title">Impormasyon para Mahanap ang Kapatid</h5>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="contactnum"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="contactnum">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="address"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="address">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="barangay"></label></h5>
                            <div class="col-lg-9">
                                <select disabled class="form-select" id="barangay" aria-label="CivilStatus" placeholder="placeholder" asp-for="barangay">
                                    <option value="1" selected>Bahay Toro</option>
                                    <option value="2">Project 6</option>
                                    <option value="3">Pag-asa</option>
                                    <option value="4">Bago Bantay</option>
                                    <option value="5">Culiat</option>
                                    <option value="6">Vasra</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="purok"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="number" class="form-control" id="givenname" asp-for="purok">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="grupo"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="number" class="form-control" id="givenname" asp-for="grupo">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="newpurok"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="number" class="form-control" id="givenname" asp-for="newpurok">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="newgrupo"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="number" class="form-control" id="givenname" asp-for="newgrupo">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="sambahayan"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="number" class="form-control" id="givenname" asp-for="sambahayan">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="relasyon"></label></h5>
                            <div class="col-lg-9">
                                <select disabled class="form-select" id="relasyon" aria-label="Relasyon" placeholder="placeholder" asp-for="relasyon">
                                    <option value="IND">INDIVIDUAL</option>
                                    <option value="PANGULO">PANGULO</option>
                                    <option value="ASAWA">ASAWA</option>
                                    <option value="AMA">AMA</option>
                                    <option value="INA">INA</option>
                                    <option value="ANAK">ANAK</option>
                                    <option value="KAPATID">KAPATID</option>
                                    <option value="LOLO">LOLO</option>
                                    <option value="LOLA">LOLA</option>
                                    <option value="APO">APO</option>
                                    <option value="TITO">TITO</option>
                                    <option value="TITA">TITA</option>
                                    <option value="PAMANGKIN">PAMANGKIN</option>
                                    <option value="BIYANAN">BIYANAN</option>
                                    <option value="BAYAW">BAYAW</option>
                                    <option value="HIPAG">HIPAG</option>
                                    <option value="BALE">BALE</option>
                                    <option value="KASAMBAHAY">KASAMBAHAY</option>
                                </select>
                            </div>
                        </div>

                        <hr />
                        <h5 class="card-title">Impormasyon sa Pananampalataya</h5>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="entrynum"></label></h5>
                            <div class="col-xxl-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="entrynum">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="idnum"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="idnum">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="registrynum"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" oninput="this.value = this.value.toUpperCase()" asp-for="registrynum">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="organization"></label></h5>
                            <div class="col-lg-9">
                                <select disabled class="form-select" id="organization" aria-label="Organization" placeholder="placeholder" asp-for="organization">
                                    <option value="BUK" selected>BUKLOD</option>
                                    <option value="KAD">KADIWA</option>
                                    <option value="BIN">BINHI</option>
                                </select>
                            </div>
                        </div>

                        <input hidden type="date" class="form-control" value="@Model.baptismdate.ToString("yyyy-MM-dd")" asp-for="baptismdate">
                        
                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="firstlokal"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="firstlokal">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="firstdistrito"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="firstdistrito">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <h5 class="col-lg-3 label"><label asp-for="minister"></label></h5>
                            <div class="col-lg-9">
                                <input disabled type="text" class="form-control" id="givenname" asp-for="minister">
                            </div>
                        </div>

                        <input type="number" id="entryid" asp-for="entryid" hidden />
                        <input type="text" id="isactive" asp-for="isactive" hidden />
                        <input type="date" id="createdate" asp-for="createdate" hidden />
                        <input type="text" id="createby" asp-for="createby" hidden>
                        <input type="date" id="modifieddate" asp-for="modifieddate" value="@DateTime.Today.ToString("yyyy-MM-dd")" hidden>
                        <input type="text" id="modifiedby" asp-for="modifiedby" value="@User.Identity.Name" hidden>
                        <input type="text" id="isdeleted" asp-for="isdeleted" value="1" />
                    </div>
                </div>

            </div>
        </form>
    </div>
</section>