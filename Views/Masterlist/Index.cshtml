
@model IEnumerable<Katuwang.Models.Masterlist>
@{
    ViewData["Title"] = "SENSO";
    ViewData["Breadcrumps"] = "SENSO / Bautisado / Masterlist";
    ViewData["Header"] = "Masterlist ng lahat ng mga kapatid";
}
<!-- Recent Sales -->
<div class="col-12">
    <div class="card overflow-auto">

        <a class="btn btn-outline-success m-3" asp-area="" asp-controller="Masterlist" asp-action="Create"><i class="bi bx-image-add me-1"></i> Add Record</a>
        <div class="card-body">

            @if (Model.Count() > 0)
            {
                <table class="table table-borderless datatable">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Unang Pangalan</th>
                            <th scope="col">Pangalan sa Ina</th>
                            <th scope="col">Pangalan sa Ama</th>
                            <th scope="col">Pangalan sa Asawa</th>
                            <th scope="col">P-G</th>
                            <th scope="col">Kapisanan</th>
                            <th scope="col">Updating</th>
                            <th scope="col">INOUT</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in Model)
                        {
                            <tr class=@if (@person.isactive == 1) { @Html.Raw("") } else { @Html.Raw("table-secondary") }>
                                <td>@person.entryid</td>
                                <td>@person.givenname @person.suffix</td>
                                <td>@person.mothersname</td>
                                <td>@person.fathersname</td>
                                <td>@person.spousename</td>
                                <td>@person.purok-@person.grupo</td>
                                <td>@person.organization</td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @if (@person.isupdated == 1) { @Html.Raw("checked") }>
                                    </div>

                                </td>
                                <td>
                                    @if (@person.isactive == 1)
                                    {
                                        <b>IN</b>
                                    }
                                    @if (@person.isactive == 0)
                                    {
                                        <b>OUT</b>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Masterlist" asp-action="View" asp-route-Id="@person.entryid"><span class="badge rounded-pill bg-primary"> <i class="bi bi-eye" data-bs-toggle="tooltip" data-bs-placement="top" title="Tooltip on top"></i></span></a>
                                    <a asp-controller="Masterlist" asp-action="Update" asp-route-Id="@person.entryid"><span class="badge rounded-pill bg-warning"> <i class="bi bi-pencil" data-bs-toggle="tooltip" data-bs-placement="top" title="Tooltip on top"></i></span></a>
                                    <a asp-controller="Masterlist" asp-action="Delete" asp-route-Id="@person.entryid"><span class="badge rounded-pill bg-danger"> <i class="bi bi-trash" data-bs-toggle="tooltip" data-bs-placement="top" title="Tooltip on top"></i></span></a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>
</div>


<script type="text/javascript">
    $(document).on('change', '.form-check-input', function () {
        var isChecked = $(this).prop('checked');
        var entryId = $(this).closest('tr').find('td:first').text();

        $('#loading').modal('show');

        // Add a delay of 1 second before sending the AJAX request
        setTimeout(function() {
            $.ajax({
                url: '@Url.Action("UpdateIsUpdated", "Masterlist")',
                type: 'POST',
                data: { entryId: entryId, isChecked: isChecked },
                success: function (result) {
                    $('#loading').modal('hide');
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log(textStatus + ': ' + errorThrown);
                }
            });
        }, 1000);
    });

</script>

