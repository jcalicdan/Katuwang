@model Katuwang.Models.Masterlist
@{
    ViewData["Title"] = "SENSO";
    ViewData["Breadcrumps"] = "SENSO / Masterlist / View";
    ViewData["Header"] = "Impormasyon ng Kapatid";
}


<section class="section profile">
    <div class="row">
        <div class="col-xl-4">

            <div class="card">
                <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">

                    <img src="~/assets/img/profile-img.jpg" alt="Profile" class="rounded-circle">
                    <h2>@Model.givenname</h2>
                    <h3>Purok - @Model.purok  Grupo - @Model.grupo</h3>
                    <div class="mt-3">
                        <h1><span class="badge bg-primary">VIEW MODE <i class="bi bi-eye"></i></span></h1>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xl-8">

            <div class="card">
                <div class="card-body pt-3">
                    <!-- Bordered Tabs -->
                    <ul class="nav nav-tabs nav-tabs-bordered">

                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-overview">Overview</button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-contact">Contact Information</button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-faith">Faith Information</button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-duty">Tungkulin</button>
                        </li>

                    </ul>
                    <div class="tab-content pt-2">

                        <div class="tab-pane fade show active profile-overview" id="profile-overview">
                            <h5 class="card-title">Pangunahing Detalye</h5>

                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="givenname"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.givenname</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="suffix"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.suffix</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="mothersname"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.mothersname</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="fathersname"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.fathersname</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="spousename"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.spousename</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="gender"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.gender</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="birthdate"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.birthdate.ToLongDateString()</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="civilstatus"></label></div>
                                <div class="col-lg-9 col-md-8"> @Model.civilstatus</div>
                            </div>

                            <hr />
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="spouse"></label></div>
                                <div class="col-lg-9 col-md-8"> @Model.spouse</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="weddingdate"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.weddingdate.ToLongDateString()</div>
                            </div>

                            <hr />
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="remarks1"></label></div>
                                <div class="col-lg-9 col-md-8"> @Model.remarks1</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="remarks2"></label></div>
                                <div class="col-lg-9 col-md-8"> @Model.remarks2</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="remarks3"></label></div>
                                <div class="col-lg-9 col-md-8"> @Model.remarks3</div>
                            </div>


                        </div>

                        <div class="tab-pane fade profile-overview" id="profile-contact">
                            <h5 class="card-title">Mga Ipormasyon para Mahanap ang Kapatid</h5>

                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="contactnum"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.contactnum</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="address"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.address</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="barangay"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.barangay</div>
                            </div>
                        </div>

                        <div class="tab-pane fade profile-overview" id="profile-faith">
                            <h5 class="card-title">Impormasyon Ukol sa Pananampalataya</h5>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="entrynum"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.entrynum</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="idnum"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.idnum</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="registrynum"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.registrynum</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="baptismdate"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.baptismdate.ToLongDateString()</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="minister"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.minister</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="firstlokal"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.firstlokal</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-4 label "><label asp-for="firstdistrito"></label></div>
                                <div class="col-lg-9 col-md-8">@Model.firstdistrito</div>
                            </div>
                        </div>

                        <div class="tab-pane fade profile-overview" id="profile-duty">
                            <h5 class="card-title">Mga Tungkulin</h5>

                        </div>


                    </div><!-- End Bordered Tabs -->

                </div>
            </div>

        </div>
    </div>
</section>