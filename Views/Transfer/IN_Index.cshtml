
@model IEnumerable<Katuwang.Models.Masterlist>
@{
    ViewData["Title"] = "SENSO";
    ViewData["Breadcrumps"] = "SENSO / Trasfer";
    ViewData["Header"] = "Pumili ng Kapatid na Magtatransfer";
}
<!-- Recent Sales -->
<div class="col-12">
    <div class="card overflow-auto">

        <div class="card-body">

            @if (Model.Count() > 0)
            {
                <table class="table table-borderless datatable">
                    <thead>
                        <tr>
                            <th scope="col">Unang Pangalan</th>
                            <th scope="col">Pangalan sa Ina</th>
                            <th scope="col">Pangalan sa Ama</th>
                            <th scope="col">Pangalan sa Asawa</th>
                            <th scope="col">Purok</th>
                            <th scope="col">Grupo</th>
                            <th scope="col">Kapisanan</th>
                            <th scope="col">Kalagayan</th>
                            <th scope="col">INOUT</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in Model)
                        {
                            <tr>
                                <td>@person.givenname @person.suffix</td>
                                <td>@person.mothersname</td>
                                <td>@person.fathersname</td>
                                <td>@person.spousename</td>
                                <td>@person.purok</td>
                                <td>@person.grupo</td>
                                <td>@person.organization</td>
                                <td>Masigla</td>
                                <td>
                                    @if (@person.isactive == 1)
                                    {
                                        <b>IN</b>
                                    }
                                    @if (@person.isactive == 0)
                                    {
                                        <b>OUT</b>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Transfer" asp-action="IN_Create" asp-route-Id="@person.entryid"><span class="badge rounded-pill bg-primary">SELECT</span></a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>
</div><!-- End Recent Sales -->